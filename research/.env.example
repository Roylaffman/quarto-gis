# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=your_database
PG_USER=your_username
PG_PASSWORD=your_password

# GCS
GCS_BUCKET=gs://your-bucket-name

# Project paths
PROJECT_DIR=C:\path\to\quarto-gis
ANALYSIS_DIR=C:\path\to\quarto-gis\research\analysis
OUTPUT_DIR=C:\path\to\quarto-gis\research\_output\analysis

# Obsidian / Substack paths
OBSIDIAN_DIR=G:\My Drive\Your Obsidian Vault
SUBSTACK_DIR=G:\My Drive\Your Obsidian Vault\Substack
SUBSTACK_IMAGES_DIR=G:\My Drive\Your Obsidian Vault\Substack\images
